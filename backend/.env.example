DATABASE_URL="postgresql://triajemedicou_local:triajemedicou_local_password@localhost:5432/triajemedicou?schema=public"
PORT=3000
SESSION_TTL_HOURS=8
# Defaults to true when NODE_ENV=production. Keep false only for local HTTP development.
COOKIE_SECURE=false
PASSWORD_RECOVERY_LIMIT=5
PASSWORD_RECOVERY_WINDOW_MINUTES=15

# Required only when running `npm run prisma:seed --workspace backend`.
# Replace every placeholder before seeding. Use a unique initial administrator
# username, a password with 8+ characters including at least one letter and one
# number, and real identity values supplied through a private local/production
# environment file. Never commit real credentials or identity data.
DEFAULT_ADMIN_USERNAME="replace-with-initial-admin-username"
DEFAULT_ADMIN_PASSWORD="replace-with-strong-initial-admin-password"
DEFAULT_ADMIN_FULL_NAME="replace-with-initial-admin-full-name"
DEFAULT_ADMIN_DATE_OF_BIRTH="YYYY-MM-DD"
DEFAULT_ADMIN_SEX="MALE"
DEFAULT_ADMIN_NATIONAL_ID="replace-with-initial-admin-national-id"
